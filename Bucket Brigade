#include <iostream>
#include <cstdio>
#include <cmath>
#include <vector>
#include <algorithm>

using namespace std;

int main() {

	//freopen("buckets.in", "r", stdin);

	int Bx = 0, By = 0, Rx = 0, Ry = 0, Lx = 0, Ly = 0, x, y;
	char box;
	for (y = 1; y <= 10; y++) {
		for (x = 1; x <= 10; x++) {
			cin >> box;
			if (box == 'B') {
				Bx = x;
				By = y;
			}
			else if (box == 'R') {
				Rx = x;
				Ry = y;
			}
			else if (box == 'L') {
				Lx = x;
				Ly = y;
			}
			else{}
		}
	}
	//cout << "Barn = " << Bx << ", " << By << endl;
	//cout << "Lake = " << Lx << ", " << Ly << endl;
	//cout << "Rock = " << Rx << ", " << Ry << endl;

	int dx = fabs(Bx - Lx);
	//cout << "dx = " << dx << endl;
	int dy = fabs(By - Ly);
	//cout << "dy = " << dy << endl;
	
	int distance = 0;

	if (dx == 0) {
		distance = dy - 1;
		if (Rx == Bx){
			if ((Ly < Ry and Ry < By) or (By < Ry and Ry < Ly)) {
				distance = dy + 1;
			}
		}
	}
	else if (dy == 0) {
		distance = dx - 1;
		//cout << "distance = " << distance << endl;
		if (Ry == By) {
			if ((Lx < Rx and Rx < Bx) or (Bx < Rx and Rx < Lx)) {
				distance = dx + 1;
				//cout << "distance =" << distance << endl;
			}
		}
	}
	else {
		distance = dx + dy - 1;
	}

	cout << distance << endl;

	return 0;
}
