#include <iostream>
#include <cstdio>
#include <cmath>
#include <vector>
#include <algorithm>

using namespace std;

int main() {

	int x1, y1, x2, y2;
	int x3, y3, x4, y4;

	cin >> x1 >> y1 >> x2 >> y2 >> x3 >> y3 >> x4 >> y4;

	int left, right;

	left = min(min(x1, x2), min(x3, x4));
	right = max(max(x1, x2), max(x3, x4));

	int top, bottom;

	bottom = min(min(y1, y2), min(y3, y4));
	top = max(max(y1, y2), max(y3, y4));

	

	int side;

	side = max(top - bottom, right - left );
	
	int area = side * side;

	cout << area << endl;

	return 0;
}
